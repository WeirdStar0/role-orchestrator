{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:role-orchestrator:schema:execution-result",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "outcome": {
      "enum": [
        "completed",
        "blocked",
        "needs_approval"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "artifactRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "kind": {
            "enum": [
              "report",
              "design",
              "test-result",
              "patch",
              "context-manifest"
            ]
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    },
    "memoryProposals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "temporary",
              "fact",
              "discovery",
              "decision",
              "project_rule"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "minItems": 0,
            "maxItems": 32
          }
        },
        "required": [
          "type",
          "content",
          "evidenceRefs"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "fact",
                    "decision",
                    "project_rule"
                  ]
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "evidenceRefs": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 0,
      "maxItems": 64
    },
    "taskProposals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "review": {
      "type": "object",
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "blocked"
          ]
        },
        "candidateSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [
        "verdict",
        "candidateSha",
        "evidenceRefs",
        "findings"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "outcome",
    "summary",
    "artifactRefs",
    "memoryProposals",
    "taskProposals"
  ],
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "role": {
          "enum": [
            "coordinator",
            "architect",
            "developer",
            "reviewer"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "minItems": 0,
          "maxItems": 63,
          "uniqueItems": true
        },
        "capabilityTags": {
          "type": "array",
          "items": {
            "enum": [
              "planning",
              "architecture",
              "frontend",
              "backend",
              "fullstack",
              "testing",
              "security",
              "devops"
            ]
          },
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "minItems": 1,
          "maxItems": 20
        }
      },
      "required": [
        "id",
        "role",
        "title",
        "objective",
        "dependencies",
        "capabilityTags",
        "acceptanceCriteria"
      ],
      "additionalProperties": false
    }
  }
}
