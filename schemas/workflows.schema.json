{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:role-orchestrator:schema:workflows",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/node"
            },
            "minItems": 1,
            "maxItems": 256
          }
        },
        "required": [
          "id",
          "name",
          "nodes"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    }
  },
  "required": [
    "schemaVersion",
    "workflows"
  ],
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "role": {
          "enum": [
            "coordinator",
            "architect",
            "developer",
            "reviewer"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "minItems": 0,
          "maxItems": 63,
          "uniqueItems": true
        },
        "capabilityTags": {
          "type": "array",
          "items": {
            "enum": [
              "planning",
              "architecture",
              "frontend",
              "backend",
              "fullstack",
              "testing",
              "security",
              "devops"
            ]
          },
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "minItems": 1,
          "maxItems": 20
        }
      },
      "required": [
        "id",
        "role",
        "title",
        "objective",
        "dependencies",
        "capabilityTags",
        "acceptanceCriteria"
      ],
      "additionalProperties": false
    }
  }
}
