{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "role-orchestrator-shell",
  "version": "0.2.0",
  "identifier": "org.role-orchestrator.desktop-shell",
  "build": {
    "frontendDist": "./shell-ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'none'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "sidecar/serve-bundle.mjs": "serve-bundle.mjs",
      "node-runtime/node.exe": "node-runtime/node.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
