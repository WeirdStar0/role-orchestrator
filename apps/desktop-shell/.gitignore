# Rust/Cargo build output (NOT ignored by the repo-root .gitignore by design:
# the shell is a standalone Cargo project outside the npm workspace).
/target/

# Generated by tauri-build (ACL/permission schema JSON, regenerated per build).
/gen/schemas/

# 便携 node 运行时(scripts/fetch-node-runtime.mjs 下载产物,构建期工具,
# 不入库;SHA256 口径见该脚本头常量与 PROPOSALS M8-05 披露)。
/node-runtime/

# 同步进树的 serve bundle 副本(scripts/sync-shell-sidecar.mjs 产物,仅供
# tauri bundle.resources 引用;真源是 packages/local-api/dist/serve-bundle.mjs)。
/sidecar/
