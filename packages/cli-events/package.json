{
  "name": "@role-orchestrator/cli-events",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Robust JSONL parsing and normalization of claude/codex CLI event streams (12 normalized event types) with strict, fail-closed outcome evaluation.",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@role-orchestrator/contracts": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@role-orchestrator/fake-cli": "workspace:*",
    "@types/node": "^25.9.8",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
