{
  "name": "@role-orchestrator/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared runtime contracts (migrated from contracts/runtime.ts) and Zod schemas mirroring the frozen planning-bundle JSON Schemas.",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.8",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "yaml": "^2.9.1"
  }
}
